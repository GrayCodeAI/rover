{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rover:config:v1alpha1",
  "title": "Rover configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "checks",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "rover/v1alpha1"
    },
    "checks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv",
          "timeout",
          "required",
          "parser"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 65536,
              "pattern": "^[^\\u0000]*$"
            }
          },
          "timeout": {
            "type": "string",
            "description": "Go duration syntax, runtime-enforced range 1ms..24h"
          },
          "required": {
            "type": "boolean"
          },
          "parser": {
            "enum": [
              "exit-code",
              "go-test-json",
              "junit",
              "sarif"
            ]
          },
          "min_tests": {
            "type": "integer",
            "minimum": 0
          },
          "report_path": {
            "type": "string",
            "description": "Canonical relative path, checked by runtime"
          },
          "pass_env": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "fail_level": {
            "enum": [
              "",
              "note",
              "warning",
              "error"
            ]
          },
          "property": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "parser": {
                  "const": "exit-code"
                }
              }
            },
            "then": {
              "properties": {
                "min_tests": {
                  "const": 0
                },
                "report_path": {
                  "const": ""
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "parser": {
                  "enum": [
                    "go-test-json",
                    "junit"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "min_tests"
              ],
              "properties": {
                "min_tests": {
                  "minimum": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "parser": {
                  "const": "junit"
                }
              }
            },
            "then": {
              "required": [
                "report_path"
              ],
              "properties": {
                "report_path": {
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "parser": {
                  "const": "go-test-json"
                }
              }
            },
            "then": {
              "properties": {
                "report_path": {
                  "const": ""
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "parser": {
                  "const": "sarif"
                }
              }
            },
            "then": {
              "required": [
                "report_path"
              ],
              "properties": {
                "report_path": {
                  "minLength": 1
                },
                "min_tests": {
                  "const": 0
                }
              }
            }
          }
        ]
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_review"
      ],
      "properties": {
        "require_review": {
          "type": "boolean"
        },
        "review_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
