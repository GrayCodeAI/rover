{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "check_ids",
    "mutations"
  ],
  "properties": {
    "schema": {
      "const": "rover/v1alpha1"
    },
    "check_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "before",
          "after"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string"
          }
        }
      }
    }
  }
}
