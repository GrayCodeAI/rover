{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "check_id",
    "test_paths",
    "test_id",
    "failure_contains"
  ],
  "properties": {
    "schema": {
      "const": "rover/v1alpha1"
    },
    "check_id": {
      "type": "string"
    },
    "test_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "failure_contains": {
      "type": "string",
      "minLength": 1
    }
  }
}
