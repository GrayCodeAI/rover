{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rover:workflow:v1alpha1",
  "title": "Rover bounded workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objective",
    "repository",
    "base",
    "timeout",
    "max_parallel",
    "allow_unreviewed_handoffs",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "rover/v1alpha1"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "timeout": {
      "type": "string"
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "allow_unreviewed_handoffs": {
      "type": "boolean"
    },
    "config_path": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "task"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "task": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Rover task v1alpha1",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objective",
              "argv",
              "timeout",
              "auto_verify"
            ],
            "properties": {
              "schema": {
                "const": "rover/v1alpha1"
              },
              "objective": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "base": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "minItems": 0,
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "maxLength": 65536,
                  "pattern": "^[^\\u0000]*$"
                }
              },
              "timeout": {
                "type": "string"
              },
              "auto_verify": {
                "const": true
              },
              "pass_env": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "depends_on": {
                "type": "array",
                "maxItems": 0,
                "items": {
                  "type": "string"
                },
                "description": "Direct task dependencies are unsupported; use workflow node.depends_on."
              },
              "agent": {
                "enum": [
                  "",
                  "generic-headless",
                  "generic-pty",
                  "codex-exec",
                  "claude-print"
                ]
              },
              "interactive": {
                "type": "boolean"
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "repair_argv": {
                "type": "array",
                "minItems": 0,
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "maxLength": 65536,
                  "pattern": "^[^\\u0000]*$"
                }
              },
              "reservations": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
                }
              },
              "agent_options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "executable": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "write": {
                    "type": "boolean"
                  },
                  "allowed_tools": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "max_turns": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "agent"
                  ],
                  "properties": {
                    "agent": {
                      "enum": [
                        "codex-exec",
                        "claude-print"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "argv": {
                      "maxItems": 0
                    },
                    "interactive": {
                      "const": false
                    }
                  }
                },
                "else": {
                  "properties": {
                    "argv": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
